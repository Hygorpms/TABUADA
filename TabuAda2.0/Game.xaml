<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TabuAda2._0.Game"
             BackgroundColor="#FFFFFF">

    <ScrollView>

        <VerticalStackLayout Spacing="25" Padding="0,5" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand">

            <Button x:Name="record" Text="RECORD" TextColor="Coral" BorderColor="Coral"
                    BorderWidth="2" FontAttributes="Bold" BackgroundColor="White"
                    MinimumWidthRequest="250" HorizontalOptions="CenterAndExpand" />

            <HorizontalStackLayout HorizontalOptions="CenterAndExpand" Spacing="10">

                <Button x:Name="LBPONTUACAO" Text="000" FontAttributes="Bold" 
                        FontSize="Medium" TextColor="Coral" BorderColor="Coral"
                        BorderWidth="2" BackgroundColor="White" MinimumWidthRequest="120"
                        HorizontalOptions="CenterAndExpand" />

                <Button x:Name="TEMPO" Text="00:00" FontAttributes="Bold" 
                        FontSize="Medium" TextColor="Coral" BorderColor="Coral"
                        BorderWidth="2" BackgroundColor="White" MinimumWidthRequest="120"
                        HorizontalOptions="CenterAndExpand" />

            </HorizontalStackLayout>

            <Button x:Name="calculo" Text="caaaalculo" FontAttributes="Bold" 
                    FontSize="Large" TextColor="Coral" BorderColor="Coral"
                    BorderWidth="2" BackgroundColor="White" MinimumWidthRequest="230"
                    HorizontalOptions="CenterAndExpand" />

            <Grid Padding="10" HorizontalOptions="CenterAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Display para a entrada/saída da calculadora -->
                <Label x:Name="CalculatorDisplay" Grid.Row="0"
                       BackgroundColor="#C32A2A" FontSize="36" Text="0"
                       HorizontalTextAlignment="End" VerticalTextAlignment="Center"
                       HorizontalOptions="FillAndExpand" />

                <!-- Teclado numérico -->
                <Grid Grid.Row="1" RowSpacing="5" ColumnSpacing="5"
                      Padding="0,10,0,0" HorizontalOptions="CenterAndExpand">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Botões para os números -->
                    <Button Grid.Row="0" Grid.Column="0" Text="1" Clicked="OnNumberClicked" 
                            MinimumWidthRequest="65" TextColor="Coral"
                            FontSize="20" FontAttributes="Bold"
                            BorderColor="Coral" BorderWidth="2" />

                    <Button Grid.Row="0" Grid.Column="1" Text="2" Clicked="OnNumberClicked"
                            TextColor="Coral" FontSize="20"
                            MinimumWidthRequest="65" FontAttributes="Bold"
                            BorderColor="Coral" BorderWidth="2" />

                    <Button Grid.Row="0" Grid.Column="2" Text="3" Clicked="OnNumberClicked"
                            TextColor="Coral" FontSize="20"
                            MinimumWidthRequest="65" HorizontalOptions="CenterAndExpand"
                            FontAttributes="Bold" BorderColor="Coral" BorderWidth="2" />

                    <Button Grid.Row="1" Grid.Column="0" Text="4" Clicked="OnNumberClicked"
                            TextColor="Coral" FontSize="20"
                            FontAttributes="Bold" BorderColor="Coral" BorderWidth="2" />

                    <Button Grid.Row="1" Grid.Column="1" Text="5" Clicked="OnNumberClicked" 
                            TextColor="Coral" FontSize="20"
                            FontAttributes="Bold" BorderColor="Coral" BorderWidth="2" />

                    <Button Grid.Row="1" Grid.Column="2" Text="6" Clicked="OnNumberClicked" 
                            TextColor="Coral" FontSize="20"
                            FontAttributes="Bold" BorderColor="Coral" BorderWidth="2" />

                    <Button Grid.Row="2" Grid.Column="0" Text="7" Clicked="OnNumberClicked" 
                            TextColor="Coral" FontSize="20"
                            FontAttributes="Bold" BorderColor="Coral" BorderWidth="2" />

                    <Button Grid.Row="2" Grid.Column="1" Text="8" Clicked="OnNumberClicked" 
                            TextColor="Coral" FontSize="20"
                            FontAttributes="Bold" BorderColor="Coral" BorderWidth="2" />

                    <Button Grid.Row="2" Grid.Column="2" Text="9" Clicked="OnNumberClicked" 
                            TextColor="Coral" FontSize="20"
                            FontAttributes="Bold" BorderColor="Coral" BorderWidth="2" />

                    <Button Grid.Row="3" Grid.Column="0" Text="0" Clicked="OnNumberClicked" 
                            TextColor="Coral" FontSize="20"
                            FontAttributes="Bold" BorderColor="Coral" BorderWidth="2" />

                    <Button Grid.Row="3" Grid.Column="1" Text="Backspace" Clicked="OnBackspaceClicked"
                            TextColor="Coral" Grid.ColumnSpan="2"
                            FontSize="20" FontAttributes="Bold" 
                            BorderColor="Coral" BorderWidth="2" />
                </Grid>
            </Grid>

            <Button x:Name="confirmar" Text="INICIAR JOGO" TextColor="Coral"
                    FontAttributes="Bold" BackgroundColor="White" BorderColor="Coral"
                    BorderWidth="2" MinimumWidthRequest="210" HorizontalOptions="CenterAndExpand"
                    Clicked="confirmar_Clicked" />

            <HorizontalStackLayout Spacing="5" HorizontalOptions="CenterAndExpand">
                <Button x:Name="home" Text="HOME" TextColor="coral" BorderColor="Coral"
                        BorderWidth="2" FontAttributes="Bold" BackgroundColor="white"
                        MinimumWidthRequest="30" HorizontalOptions="CenterAndExpand"
                        Clicked="home_Clicked" />

                <Button x:Name="zerar" Text="REINICIAR JOGO" BorderColor="Coral"
                        BorderWidth="2" TextColor="Coral" FontAttributes="Bold"
                        BackgroundColor="White" MinimumWidthRequest="80"
                        HorizontalOptions="CenterAndExpand" Clicked="zerar_Clicked" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>